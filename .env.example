# Single-instance Compose. Railway: Backend/railway.env.example and Backend/RAILWAY.md.
# Copy to .env in the repository root. Never commit real credentials.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Use a URL-safe random value because this is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_USER=kayipqr
POSTGRES_DB=kayipqr_prod

PUBLIC_APP_URL=https://kayipqr.com
BACKEND_BASE_URL=https://api.kayipqr.com
NEXT_PUBLIC_API_URL=https://api.kayipqr.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.kayipqr.com
NEXT_PUBLIC_APP_URL=https://kayipqr.com
BACKEND_CORS_ORIGINS=["https://kayipqr.com","https://www.kayipqr.com"]
# Add only the verified source IP/CIDR of your reverse proxy, never all private networks.
TRUSTED_PROXIES=["127.0.0.1","::1"]

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@kayipqr.com
EMAILS_FROM_NAME=KayıpQR
MAX_STORAGE_SIZE_MB=1024
