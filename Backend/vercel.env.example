# Backend Vercel project. Scope these to Production; Preview needs its own DB.
ENVIRONMENT=production
SERVERLESS_MODE=true
SINGLE_INSTANCE_MODE=false
RUN_BACKGROUND_TASKS=false
RUN_MIGRATIONS=false
APP_ROLE=web
REDIS_URL=""
DATABASE_URL=postgresql://user:password@your-pooled-host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@your-direct-host/database?sslmode=require
SECRET_KEY=
CRON_SECRET=
PUBLIC_APP_URL=https://your-frontend.vercel.app
BACKEND_BASE_URL=https://your-backend.vercel.app
BACKEND_CORS_ORIGINS=["https://your-frontend.vercel.app"]
PROXY_MODE=vercel
TRUSTED_PROXIES=[]
STORAGE_BACKEND=database
MAX_UPLOAD_SIZE_MB=3
DB_IMAGE_MAX_BYTES=262144
MAX_STORAGE_SIZE_MB=200
CHAT_PHOTO_RETENTION_DAYS=30
EMAIL_PROVIDER=resend
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAILS_FROM_EMAIL=info@your-verified-domain.example
EMAILS_FROM_NAME=KayıpQR
