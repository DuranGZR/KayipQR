# Low-traffic profile: one Backend process, no Redis or separate Worker service.
# Reference names Postgres/Bucket must match the resources in your project.
# Set these variables on Backend, never on Frontend.
ENVIRONMENT=production
APP_ROLE=web
RUN_BACKGROUND_TASKS=true
RUN_MIGRATIONS=false
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=""
SINGLE_INSTANCE_MODE=true
CHAT_PHOTO_RETENTION_DAYS=30
REDIS_PREFIX=kayipqr
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
SECRET_KEY=
PUBLIC_APP_URL=https://your-site.example
BACKEND_BASE_URL=https://your-api.example
BACKEND_CORS_ORIGINS=["https://your-site.example"]
PROXY_MODE=railway
TRUSTED_PROXIES=[]

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
S3_BUCKET=${{Bucket.BUCKET}}
S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_REGION=${{Bucket.REGION}}
S3_ADDRESSING_STYLE=virtual
MAX_UPLOAD_SIZE_MB=5
MAX_ACTIVE_REQUESTS=200
MAX_STORAGE_SIZE_MB=1024

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAILS_FROM_EMAIL=info@your-site.example
EMAILS_FROM_NAME=KayıpQR

# For multiple backend replicas instead: SINGLE_INSTANCE_MODE=false,
# REDIS_URL=${{Redis.REDIS_URL}}, RUN_BACKGROUND_TASKS=false;
# add a separate Worker with APP_ROLE=worker and the same shared variables.
# Set only these public build variables on Frontend:
# NEXT_PUBLIC_API_URL=https://your-api.example/api/v1
# NEXT_PUBLIC_WS_URL=wss://your-api.example
# NEXT_PUBLIC_APP_URL=https://your-site.example
