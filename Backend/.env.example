# ==============================================================================
# KayıpQR — Backend Environment Variables Configuration
# ==============================================================================

# Environment Mode: "development", "staging", "production"
ENVIRONMENT=development

PROJECT_NAME="KayıpQR API"
API_V1_STR="/api/v1"

# Production Secret Key (Generate via: openssl rand -hex 32)
# In production, must be at least 32 characters and cannot be default.
SECRET_KEY="supersecret_kayipqr_jwt_key_change_in_production_secure_random"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL
# Development: SQLite
DATABASE_URL="sqlite+aiosqlite:///./kayipqr.db"
# Production: PostgreSQL (asyncpg)
# DATABASE_URL="postgresql+asyncpg://postgres:YourSecureDbPassword@localhost:5432/kayipqr"

# Application URLs
PUBLIC_APP_URL="http://localhost:3000"
BACKEND_BASE_URL="http://localhost:8000"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# For production:
# BACKEND_CORS_ORIGINS="https://kayipqr.com,https://www.kayipqr.com"

# Trusted Reverse Proxies (Cloudflare / Nginx / Caddy IPs)
TRUSTED_PROXIES="127.0.0.1,::1"
ENABLE_EXTERNAL_GEOIP=false

# Transactional Email (SMTP / Mailgun / SendGrid / Resend)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="info@kayipqr.com"
EMAILS_FROM_NAME="KayıpQR"

# Local defaults; Railway production: see railway.env.example.
APP_ROLE=web
RUN_BACKGROUND_TASKS=true
RUN_MIGRATIONS=false
REDIS_URL=""
REDIS_PREFIX=kayipqr
# One long-lived backend process only; no replicas or multiple uvicorn workers.
SINGLE_INSTANCE_MODE=true
# Only chat photo attachments expire; message text, profile/item images remain.
CHAT_PHOTO_RETENTION_DAYS=30
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
STORAGE_BACKEND=local
MAX_STORAGE_SIZE_MB=1024
PROXY_MODE=explicit
EMAIL_PROVIDER=smtp
RESEND_API_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
