{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m app.vercel_build",
  "functions": { "app/main.py": {
    "maxDuration": 60,
    "excludeFiles": "{tests/**,scripts/**,uploads/**,venv/**,.venv/**,**/*.db,**/*.db-*,**/*.sqlite*,.env,.env.*}"
  } },
  "crons": [{ "path": "/internal/maintenance", "schedule": "0 3 * * *" }]
}
