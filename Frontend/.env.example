# KayıpQR Frontend — Environment Configuration Example
# Copy this file to .env.local for development or configure in your hosting provider

# Backend FastAPI Base URL (including /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public Frontend Base URL used for QR code links and OpenGraph metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional WebSocket origin (without /api/v1); inferred from API URL when empty
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Vercel uses polling. Long-lived local/Railway deployments may use websocket.
NEXT_PUBLIC_CHAT_TRANSPORT=websocket
